# Copy this file to supabase/.env.local and fill in real values.
# Never commit the real .env.local. Keep secrets out of git.
# Usage: supabase functions serve --env-file ./supabase/.env.local

# Secret shared with whoever runs the admin bootstrap (bootstrap-admin function)
ADMIN_SETUP_SECRET=change-me

# Admin account seeded by ensure-admin-account
Admin_Email=admin@example.com
Admin_Password=change-me-strong-password

# Recovery phrase used to derive blockchain deposit addresses (generate-deposit-address)
WALLET_MNEMONIC=change-me
